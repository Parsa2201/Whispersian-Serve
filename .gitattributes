# Text file end lines
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Binary files
*.onnx binary
*.bin binary
*.pt binary
*.ckpt binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.wav binary
*.zip binary
# Avoid merge large binaries
*.onnx -merge
*.bin -merge
*.pt -merge
*.ckpt -merge
# Large File Storage
model/ filter=lfs diff=lfs merge=lfs -text
model filter=lfs diff=lfs merge=lfs -text
model/* filter=lfs diff=lfs merge=lfs -text
